#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
report_file=$(CDPATH= cd -- "$script_dir/.." && pwd)/nvim-plugin-expanded-report.html

if [ ! -f "$report_file" ]; then
  printf 'report not found: %s\n' "$report_file" >&2
  exit 1
fi

case "$(uname -s)" in
  Darwin)
    open "$report_file"
    ;;
  Linux)
    if command -v xdg-open >/dev/null 2>&1; then
      xdg-open "$report_file" >/dev/null 2>&1 &
    else
      printf 'xdg-open is required: %s\n' "$report_file" >&2
      exit 1
    fi
    ;;
  *)
    printf 'open this file in a browser: %s\n' "$report_file"
    ;;
esac
